// Referências:
// Tabela SecurityIncident (Microsoft Sentinel / Log Analytics)
// https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/securityincident
// Quantidade de incidentes criados por mês, com status atual e classificação de fechamento.
// Cada mudança de status, owner ou classificação gera uma linha nova. O arg_max por IncidentNumber
// fica com a versão mais recente de cada incidente, e o filtro usa CreatedTime (data de abertura).
// Com a sincronização de incidentes do Defender XDR ligada, os incidentes do XDR também entram aqui.
// Pra separar, filtre ProviderName ("Microsoft XDR" para os do XDR, "Azure Sentinel" para os das regras).

let inicio = datetime(2026-01-01); // Ajuste o início do período
let fim = now();                   // Ajuste o fim do período
SecurityIncident
| where CreatedTime between (inicio .. fim)
| summarize arg_max(LastModifiedTime, *) by IncidentNumber
| extend Mes = format_datetime(CreatedTime, "yyyy-MM")
| summarize Total = count(),
            Abertos = countif(Status == "New" or Status == "Active"),
            Fechados = countif(Status == "Closed"),
            TruePositive = countif(Classification == "TruePositive"),
            FalsePositive = countif(Classification == "FalsePositive"),
            Benigno = countif(Classification == "BenignPositive")
            by Mes
| order by Mes asc
